<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.ConfigurationFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/group_tab_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?colorPrimary"
        android:elevation="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/group_tab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="?tabIndicatorColor"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="?tabRippleColor"
            app:tabSelectedTextColor="?tabSelectedTextColor"
            app:tabTextAppearance="@style/TextAppearance.SagerNet.Tab"
            app:tabTextColor="?tabTextColor"
            app:tabUnboundedRipple="false" />

        <!-- The tab row's sort button (the desktop's group sort): node count of the tabs, by the popup. -->
        <ImageButton
            android:id="@+id/group_sort"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profiles_sort_group"
            android:src="@drawable/ic_action_sort" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/group_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackThickness="2dp" />

    <TextView
        android:id="@+id/runtime_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <include layout="@layout/layout_subscription_card" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/profiles_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/group_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Down to the bottom edge: the panel keeps its content above MainActivity's stats bar and FAB.
             A wide landscape window puts it at the end side instead, full height (ConfigurationFragment). -->
        <FrameLayout
            android:id="@+id/test_panel_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</LinearLayout>
